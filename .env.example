ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Browser: "chrome" launches your installed Google Chrome in its own profile (data/profile).
# Use "msedge" for Edge, or leave empty for Playwright's bundled Chromium.
BROWSER_CHANNEL=chrome

# Optional: attach to a Chrome you started yourself instead (recommended if Google blocks sign-in):
#   chrome --remote-debugging-port=9222 --user-data-dir=$HOME/.assistant-chrome
# CDP_URL=http://127.0.0.1:9222

# Optional: sites the assistant may use without asking, comma-separated.
ALLOWED_DOMAINS=

PORT=3210
